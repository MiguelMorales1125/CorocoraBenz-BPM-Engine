{
  "schemaVersion": 16,
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.52.0"
  },
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.24.0",
  "components": [
    {
      "label": "Periodo",
      "type": "textfield",
      "id": "Field_payPeriodId",
      "key": "payPeriodId",
      "defaultValue": "2026-11-Q2",
      "disabled": true
    },
    {
      "label": "Resumen de la liquidación",
      "type": "textarea",
      "id": "Field_payrollSummary",
      "key": "payrollSummary",
      "defaultValue": "Liquidación simulada del periodo 2026-11-Q2, sin excepciones automáticas",
      "disabled": true
    },
    {
      "label": "Total calculado",
      "type": "number",
      "id": "Field_payrollTotal",
      "key": "payrollTotal",
      "defaultValue": 1000000,
      "disabled": true
    },
    {
      "label": "Motivo de la devolución de Jefatura",
      "type": "textfield",
      "id": "Field_approvalReason",
      "key": "approvalReason",
      "disabled": true
    },
    {
      "label": "Liquidación consistente",
      "type": "checkbox",
      "id": "Field_payrollConsistent",
      "key": "payrollConsistent",
      "defaultValue": true,
      "validate": {
        "required": false
      }
    },
    {
      "label": "Observación",
      "type": "textarea",
      "id": "Field_reviewComment",
      "key": "reviewComment",
      "defaultValue": "Liquidación revisada sin observaciones",
      "validate": {
        "required": false
      }
    }
  ],
  "type": "default",
  "id": "nomina-revisar-liquidacion"
}
