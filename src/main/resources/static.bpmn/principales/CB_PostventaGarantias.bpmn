<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CB_PostventaGarantias" targetNamespace="https://corocora-benz.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_SolicitudServicio" name="SolicitudServicio" />
  <bpmn:message id="Message_RepuestosDisponibles" name="RepuestosDisponibles" />
  <bpmn:message id="Message_CotizacionAceptada" name="CotizacionAceptada" />
  <bpmn:message id="Message_CotizacionRechazada" name="CotizacionRechazada" />
  <bpmn:collaboration id="Collaboration_CB_PostventaGarantias">
    <bpmn:participant id="Participant_CorocoraBenz" name="Corocora Benz" processRef="CB_PostventaGarantias" />
    <bpmn:participant id="Participant_Cliente" name="Cliente" />
    <bpmn:participant id="Participant_Bodega" name="Bodega de repuestos" />
    <bpmn:messageFlow id="MessageFlow_RepuestosDisponibles" sourceRef="Participant_Bodega" targetRef="waitParts" />
    <bpmn:messageFlow id="MessageFlow_Solicitud" sourceRef="Participant_Cliente" targetRef="startRequest" />
    <bpmn:messageFlow id="MessageFlow_Cotizacion" sourceRef="prepareQuote" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MessageFlow_Rechazo" sourceRef="Participant_Cliente" targetRef="quoteRejected" />
    <bpmn:messageFlow id="MessageFlow_Aceptacion" sourceRef="Participant_Cliente" targetRef="quoteAccepted" />
    <bpmn:messageFlow id="MessageFlow_Cierre" sourceRef="notifyRejection" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MessageFlow_Entrega" sourceRef="deliverVehicle" targetRef="Participant_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="CB_PostventaGarantias" name="Corocora Benz - Postventa y Garantías" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:laneSet id="LaneSet_CB_PostventaGarantias">
      <bpmn:lane id="Lane_Asesor" name="Asesor de Servicio">
        <bpmn:flowNodeRef>startRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registerRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vehicleLookup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prepareQuote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quoteResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quoteExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quoteRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>quoteAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notAuthorizedMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notifyRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>unauthorizedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliverVehicle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>closedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Garantias" name="Analista de Garantías">
        <bpmn:flowNodeRef>coverageDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>coverageRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewWarranty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>warrantyApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>authorizedMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinador" name="Coordinador de Postventa">
        <bpmn:flowNodeRef>parallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserveParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>partsAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waitParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>partsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scheduleWorkshop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>attendWorkshop</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startRequest" name="Solicitud de servicio recibida">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_SolicitudServicio" />
    </bpmn:startEvent>
    <bpmn:userTask id="registerRequest" name="Registrar solicitud y asignar taller" camunda:formRef="postventa-registro" camunda:formRefBinding="deployment" camunda:candidateGroups="asesores-servicio">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="vehicleLookup" name="Consultar historial y campañas del VIN" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${sistemas.tallerBodega}/api/vehiculos/${vin}?km=${mileageKm}</camunda:inputParameter>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
                <camunda:entry key="Accept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:outputParameter name="historyRecordId">${json.texto(statusCode, response, 'historyRecordId')}</camunda:outputParameter>
            <camunda:outputParameter name="warrantyEligible">${json.booleano(statusCode, response, 'warrantyEligible')}</camunda:outputParameter>
            <camunda:outputParameter name="campaignActive">${json.booleano(statusCode, response, 'campaignActive')}</camunda:outputParameter>
            <camunda:outputParameter name="campaignId">${json.texto(statusCode, response, 'campaignId')}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="coverageDecision" name="Evaluar cobertura de garantía" camunda:resultVariable="coverageDecision" camunda:decisionRef="CB_EvaluarCoberturaGarantia" camunda:mapDecisionResult="singleResult">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="coverageStatus">${coverageDecision.coverageStatus}</camunda:outputParameter>
          <camunda:outputParameter name="coverageReason">${coverageDecision.coverageReason}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="coverageRoute" name="¿Qué cobertura aplica?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reviewWarranty" name="Revisar cobertura y evidencia" camunda:formRef="postventa-garantia" camunda:formRefBinding="deployment" camunda:candidateGroups="analistas-garantia">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="warrantyApproved" name="¿Garantía aprobada?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="prepareQuote" name="Enviar cotización al cliente" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${sistemas.tallerBodega}/api/cotizaciones</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
                <camunda:entry key="Accept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">${json.cuerpo(execution, 'vin,customerName,symptom')}</camunda:inputParameter>
            <camunda:outputParameter name="quoteId">${json.texto(statusCode, response, 'quoteId')}</camunda:outputParameter>
            <camunda:outputParameter name="quoteAmount">${json.numero(statusCode, response, 'quoteAmount')}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="quoteResponse" name="Respuesta a la cotización">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="quoteExpired" name="Plazo de cotización vencido (48 h)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="quoteRejected" name="Cotización rechazada">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CotizacionRechazada" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="quoteAccepted" name="Cotización aceptada">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_CotizacionAceptada" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="notAuthorizedMerge">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="notifyRejection" name="Notificar cierre al cliente" camunda:delegateExpression="${enviarNotificacionDelegate}">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="unauthorizedEnd" name="Reparación no autorizada">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="authorizedMerge">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="parallelSplit">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="reserveParts" name="Reservar repuestos" camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${sistemas.tallerBodega}/api/reservas</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
                <camunda:entry key="Accept">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">${json.cuerpo(execution, 'vin')}</camunda:inputParameter>
            <camunda:outputParameter name="partsReservationStatus">${json.texto(statusCode, response, 'partsReservationStatus')}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="partsAvailable" name="¿Repuestos disponibles?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_PartsAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_PartsWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="waitParts" name="Esperar aviso de repuestos disponibles">
      <bpmn:incoming>Flow_PartsWait</bpmn:incoming>
      <bpmn:outgoing>Flow_PartsArrived</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RepuestosDisponibles" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="partsMerge">
      <bpmn:incoming>Flow_PartsAvailable</bpmn:incoming>
      <bpmn:incoming>Flow_PartsArrived</bpmn:incoming>
      <bpmn:outgoing>Flow_PartsReady</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="scheduleWorkshop" name="Agendar cita en el taller" camunda:candidateGroups="coordinadores-postventa" camunda:formRef="generated-schedule-workshop" camunda:formRefBinding="deployment">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="parallelJoin" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_PartsReady</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="attendWorkshop" name="Atender orden de taller" calledElement="CB_AtenderOrdenTaller" camunda:calledElementBinding="deployment">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in source="vin" target="vin" />
        <camunda:in source="symptom" target="symptom" />
        <camunda:in source="mileageKm" target="mileageKm" />
        <camunda:in source="serviceOrderId" target="serviceOrderId" />
        <camunda:out source="mileageKm" target="mileageKm" />
        <camunda:out source="diagnosis" target="diagnosis" />
        <camunda:out source="repairNotes" target="repairNotes" />
        <camunda:out source="serviceCost" target="serviceCost" />
        <camunda:out source="inspectionPassed" target="inspectionPassed" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="deliverVehicle" name="Entregar vehículo y cerrar caso" camunda:candidateGroups="asesores-servicio" camunda:formRef="generated-deliver-vehicle" camunda:formRefBinding="deployment">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="closedEnd" name="Vehículo entregado y caso cerrado">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="startRequest" targetRef="registerRequest" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="registerRequest" targetRef="vehicleLookup" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="vehicleLookup" targetRef="coverageDecision" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="coverageDecision" targetRef="coverageRoute" />
    <bpmn:sequenceFlow id="Flow_05" name="Campaña o garantía" sourceRef="coverageRoute" targetRef="reviewWarranty">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coverageStatus == 'CAMPANA_ACTIVA' || coverageStatus == 'CUBIERTO_POR_GARANTIA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="Requiere cotización" sourceRef="coverageRoute" targetRef="prepareQuote">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coverageStatus == 'REQUIERE_COTIZACION'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="reviewWarranty" targetRef="warrantyApproved" />
    <bpmn:sequenceFlow id="Flow_08" name="Sí" sourceRef="warrantyApproved" targetRef="authorizedMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coverageApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="warrantyApproved" targetRef="prepareQuote">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coverageApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="prepareQuote" targetRef="quoteResponse" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="quoteResponse" targetRef="quoteExpired" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="quoteResponse" targetRef="quoteRejected" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="quoteResponse" targetRef="quoteAccepted" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="quoteExpired" targetRef="notAuthorizedMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="quoteRejected" targetRef="notAuthorizedMerge" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="notAuthorizedMerge" targetRef="notifyRejection" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="notifyRejection" targetRef="unauthorizedEnd" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="quoteAccepted" targetRef="authorizedMerge" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="authorizedMerge" targetRef="parallelSplit" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="parallelSplit" targetRef="reserveParts" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="parallelSplit" targetRef="scheduleWorkshop" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="reserveParts" targetRef="partsAvailable" />
    <bpmn:sequenceFlow id="Flow_PartsAvailable" name="Sí" sourceRef="partsAvailable" targetRef="partsMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${partsReservationStatus == 'RESERVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PartsWait" name="No" sourceRef="partsAvailable" targetRef="waitParts">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${partsReservationStatus == 'PENDIENTE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PartsArrived" sourceRef="waitParts" targetRef="partsMerge" />
    <bpmn:sequenceFlow id="Flow_PartsReady" sourceRef="partsMerge" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="scheduleWorkshop" targetRef="parallelJoin" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="parallelJoin" targetRef="attendWorkshop" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="attendWorkshop" targetRef="deliverVehicle" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="deliverVehicle" targetRef="closedEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CB_PostventaGarantias">
    <bpmndi:BPMNPlane id="Plane_CB_PostventaGarantias" bpmnElement="Collaboration_CB_PostventaGarantias">
      <bpmndi:BPMNShape id="Participant_CorocoraBenz_di" bpmnElement="Participant_CorocoraBenz" isHorizontal="true">
        <dc:Bounds x="160" y="260" width="3320" height="1040" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinador_di" bpmnElement="Lane_Coordinador" isHorizontal="true">
        <dc:Bounds x="190" y="880" width="3290" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Garantias_di" bpmnElement="Lane_Garantias" isHorizontal="true">
        <dc:Bounds x="190" y="680" width="3290" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Asesor_di" bpmnElement="Lane_Asesor" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="3290" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startRequest_di" bpmnElement="startRequest">
        <dc:Bounds x="282" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="493" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="registerRequest_di" bpmnElement="registerRequest">
        <dc:Bounds x="435" y="430" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vehicleLookup_di" bpmnElement="vehicleLookup">
        <dc:Bounds x="625" y="430" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="coverageDecision_di" bpmnElement="coverageDecision">
        <dc:Bounds x="815" y="740" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="coverageRoute_di" bpmnElement="coverageRoute" isMarkerVisible="true">
        <dc:Bounds x="1035" y="755" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1005" y="810" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewWarranty_di" bpmnElement="reviewWarranty">
        <dc:Bounds x="1195" y="740" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="warrantyApproved_di" bpmnElement="warrantyApproved" isMarkerVisible="true">
        <dc:Bounds x="1415" y="755" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1385" y="810" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepareQuote_di" bpmnElement="prepareQuote">
        <dc:Bounds x="1575" y="430" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="quoteResponse_di" bpmnElement="quoteResponse">
        <dc:Bounds x="1795" y="445" width="50" height="50" />
