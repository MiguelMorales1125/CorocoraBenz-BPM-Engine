<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CB_ValidarNovedadEmpleado" targetNamespace="https://corocora-benz.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_CB_ValidarNovedadEmpleado">
    <bpmn:participant id="Participant_CorocoraBenz" name="Corocora Benz" processRef="CB_ValidarNovedadEmpleado" />
  </bpmn:collaboration>
  <bpmn:process id="CB_ValidarNovedadEmpleado" name="Corocora Benz - Validación de Novedad" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:laneSet id="LaneSet_CB_ValidarNovedadEmpleado">
      <bpmn:lane id="Lane_Analista" name="Analista de Nómina">
        <bpmn:flowNodeRef>startChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reviewChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changeValidGw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>changeDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TalentoHumano" name="Gestión de Talento Humano">
        <bpmn:flowNodeRef>correctChange</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startChange" name="Novedad de empleado recibida">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="reviewMerge">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reviewChange" name="Revisar novedad y soporte" camunda:formRef="nomina-revisar-novedad" camunda:formRefBinding="deployment" camunda:candidateGroups="analistas-nomina">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="changeValidGw" name="¿Novedad válida?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="changeDone" name="Novedad validada">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="startChange" targetRef="reviewMerge" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="reviewMerge" targetRef="reviewChange" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="reviewChange" targetRef="changeValidGw" />
    <bpmn:sequenceFlow id="Flow_04" name="Sí" sourceRef="changeValidGw" targetRef="changeDone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${changeValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="No" sourceRef="changeValidGw" targetRef="correctChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${changeValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="correctChange" targetRef="reviewMerge" />
    <bpmn:userTask id="correctChange" name="Corregir novedad y adjuntar soporte" camunda:candidateGroups="gestion-talento-humano" camunda:formRef="generated-correct-change" camunda:formRefBinding="deployment">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CB_ValidarNovedadEmpleado">
    <bpmndi:BPMNPlane id="Plane_CB_ValidarNovedadEmpleado" bpmnElement="Collaboration_CB_ValidarNovedadEmpleado">
      <bpmndi:BPMNShape id="Participant_CorocoraBenz_di" bpmnElement="Participant_CorocoraBenz" isHorizontal="true">
        <dc:Bounds x="160" y="120" width="1040" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_TalentoHumano_di" bpmnElement="Lane_TalentoHumano" isHorizontal="true">
        <dc:Bounds x="190" y="320" width="1010" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Analista_di" bpmnElement="Lane_Analista" isHorizontal="true">
        <dc:Bounds x="190" y="120" width="1010" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startChange_di" bpmnElement="startChange">
        <dc:Bounds x="282" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="243" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewMerge_di" bpmnElement="reviewMerge" isMarkerVisible="true">
        <dc:Bounds x="465" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewChange_di" bpmnElement="reviewChange">
        <dc:Bounds x="625" y="180" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="changeValidGw_di" bpmnElement="changeValidGw" isMarkerVisible="true">
        <dc:Bounds x="845" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="175" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="changeDone_di" bpmnElement="changeDone">
        <dc:Bounds x="1042" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1005" y="243" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="correctChange_di" bpmnElement="correctChange">
        <dc:Bounds x="625" y="380" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="318" y="220" />
        <di:waypoint x="465" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="515" y="220" />
        <di:waypoint x="625" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="735" y="220" />
        <di:waypoint x="845" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="895" y="220" />
        <di:waypoint x="1042" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="901" y="200" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="870" y="245" />
        <di:waypoint x="870" y="420" />
        <di:waypoint x="735" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="882" y="253" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="625" y="420" />
        <di:waypoint x="490" y="420" />
        <di:waypoint x="490" y="245" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
