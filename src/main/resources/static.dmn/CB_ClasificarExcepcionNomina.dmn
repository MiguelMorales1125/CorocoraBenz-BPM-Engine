<?xml version='1.0' encoding='utf-8'?>
<dmn:definitions xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_CB_ClasificarExcepcionNomina" name="Decisiones de nómina" namespace="http://camunda.org/schema/1.0/dmn" expressionLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/" typeLanguage="https://www.omg.org/spec/DMN/20191111/FEEL/" exporter="Camunda Modeler" exporterVersion="5.x">
  <dmn:decision camunda:historyTimeToLive="30" id="CB_ClasificarExcepcionNomina" name="Clasificar control de nómina">
    <dmn:description>Clasifica el periodo de nómina según su apertura, la completitud de los soportes y la presencia de novedades fuera de corte. Las condiciones se modelan como casos excluyentes.</dmn:description>
<dmn:decisionTable id="Table_CB_ClasificarExcepcionNomina" hitPolicy="UNIQUE">
      <dmn:input id="Input_1_CB_ClasificarExcepcionNomina" label="¿Periodo de nómina abierto?">
        <dmn:inputExpression id="InputExpression_1_CB_ClasificarExcepcionNomina" typeRef="boolean">
          <dmn:text>periodOpen</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues>
          <dmn:text>false, true</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="Input_2_CB_ClasificarExcepcionNomina" label="¿Soportes completos?">
        <dmn:inputExpression id="InputExpression_2_CB_ClasificarExcepcionNomina" typeRef="boolean">
          <dmn:text>documentsComplete</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues>
          <dmn:text>false, true</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:input id="Input_3_CB_ClasificarExcepcionNomina" label="¿Hay novedades fuera de corte?">
        <dmn:inputExpression id="InputExpression_3_CB_ClasificarExcepcionNomina" typeRef="boolean">
          <dmn:text>hasLateChanges</dmn:text>
        </dmn:inputExpression>
        <dmn:inputValues>
          <dmn:text>false, true</dmn:text>
        </dmn:inputValues>
      </dmn:input>
      <dmn:output id="Output_1_CB_ClasificarExcepcionNomina" name="reviewStatus" label="Ruta de revisión" typeRef="string">
        <dmn:outputValues>
          <dmn:text>"PERIODO_CERRADO", "DEVOLVER_A_TALENTO_HUMANO", "REQUIERE_APROBACION_JEFATURA", "CONTINUAR"</dmn:text>
        </dmn:outputValues>
      </dmn:output>
      <dmn:output id="Output_2_CB_ClasificarExcepcionNomina" name="reasonCode" label="Código del motivo" typeRef="string">
        <dmn:outputValues>
          <dmn:text>"REQUIERE_REAPERTURA", "SOPORTE_INCOMPLETO", "NOVEDAD_FUERA_DE_CORTE", "NOVEDADES_VALIDAS"</dmn:text>
        </dmn:outputValues>
      </dmn:output>
      <dmn:rule id="Rule_1_CB_ClasificarExcepcionNomina">
        <dmn:inputEntry id="InputEntry_1_1_CB_ClasificarExcepcionNomina">
          <dmn:text>false</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_1_2_CB_ClasificarExcepcionNomina">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_1_3_CB_ClasificarExcepcionNomina">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="OutputEntry_1_1_CB_ClasificarExcepcionNomina">
          <dmn:text>"PERIODO_CERRADO"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="OutputEntry_1_2_CB_ClasificarExcepcionNomina">
          <dmn:text>"REQUIERE_REAPERTURA"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_2_CB_ClasificarExcepcionNomina">
        <dmn:inputEntry id="InputEntry_2_1_CB_ClasificarExcepcionNomina">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_2_2_CB_ClasificarExcepcionNomina">
          <dmn:text>false</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_2_3_CB_ClasificarExcepcionNomina">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="OutputEntry_2_1_CB_ClasificarExcepcionNomina">
          <dmn:text>"DEVOLVER_A_TALENTO_HUMANO"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="OutputEntry_2_2_CB_ClasificarExcepcionNomina">
          <dmn:text>"SOPORTE_INCOMPLETO"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_3_CB_ClasificarExcepcionNomina">
        <dmn:inputEntry id="InputEntry_3_1_CB_ClasificarExcepcionNomina">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_3_2_CB_ClasificarExcepcionNomina">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_3_3_CB_ClasificarExcepcionNomina">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="OutputEntry_3_1_CB_ClasificarExcepcionNomina">
          <dmn:text>"REQUIERE_APROBACION_JEFATURA"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="OutputEntry_3_2_CB_ClasificarExcepcionNomina">
          <dmn:text>"NOVEDAD_FUERA_DE_CORTE"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_4_CB_ClasificarExcepcionNomina">
        <dmn:inputEntry id="InputEntry_4_1_CB_ClasificarExcepcionNomina">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_4_2_CB_ClasificarExcepcionNomina">
          <dmn:text>true</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry id="InputEntry_4_3_CB_ClasificarExcepcionNomina">
          <dmn:text>false</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="OutputEntry_4_1_CB_ClasificarExcepcionNomina">
          <dmn:text>"CONTINUAR"</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry id="OutputEntry_4_2_CB_ClasificarExcepcionNomina">
          <dmn:text>"NOVEDADES_VALIDAS"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
<dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_CB_ClasificarExcepcionNomina" name="DRD - Control de nómina">
      <dmndi:Size width="660" height="315" />
<dmndi:DMNShape id="DMNShape_CB_ClasificarExcepcionNomina" dmnElementRef="CB_ClasificarExcepcionNomina">
        <dc:Bounds x="390" y="105" width="220" height="100" />
      </dmndi:DMNShape>
</dmndi:DMNDiagram>
  </dmndi:DMNDI>
</dmn:definitions>